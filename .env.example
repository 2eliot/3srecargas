# ─── Base ────────────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-segura
DATABASE_URL=sqlite:///data/app.db
DATA_DIR=data

# ─── Admin inicial ───────────────────────────────────────────────────────────
ADMIN_USERNAME=tu-admin
ADMIN_PASSWORD=cambia-esto-por-una-clave-larga
ADMIN_EMAIL=admin@tudominio.com

# Código extra para entrar a Stock PINs. Sirve para que quien atiende la web
# pueda usar el resto del panel sin llegar a los códigos. Se vuelve a pedir en
# cuanto se sale de esa sección. Si lo dejas vacío, la sección queda abierta.
STOCK_PINS_ACCESS_CODE=cambia-esto-por-tu-codigo
# Red de seguridad: minutos que aguanta el acceso si te quedas dentro sin moverte.
STOCK_PINS_UNLOCK_MINUTES=30

# ─── Automatización VPS (bot de recargas) ────────────────────────────────────
AUTOMATION_SERVICE_URL=http://localhost:8000
VPS_REDEEM_URL=http://localhost:8000/redeem
# Endpoint que consulta si un PIN ya fue canjeado SIN canjearlo. Se usa para
# resolver timeouts y resultados ambiguos sin perder recargas ni devolver al
# stock PINs ya quemados.
VPS_VERIFY_URL=http://localhost:8000/redeem/verify
VPS_VERIFY_TIMEOUT=60
VPS_TIMEOUT=120
VPS_COUNTRY=Venezuela
VPS_FULL_NAME=Usuario Recarga
VPS_BIRTH_DATE=01/01/1995

# ─── Revendedores Whitelabel API ─────────────────────────────────────────────
REVENDEDORES_BASE_URL=
REVENDEDORES_API_KEY=

# ─── Binance Pay (verificación automática de pagos) ─────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Proxy de salida para las llamadas a Binance (obligatorio si el VPS está en
# una IP bloqueada por Binance).
BINANCE_PROXY=
BINANCE_REQUEST_TIMEOUT_SECONDS=15
# Minutos hacia atrás que se buscan transacciones al verificar una orden.
# El cliente ve el código, paga en la app de Binance y recién después vuelve
# a confirmar, así que el pago casi siempre es ANTERIOR a la orden. Con un
# valor bajo, todo cliente que tarde en volver queda sin verificar.
BINANCE_LOOKBACK_MINUTES=90
# Minutos durante los cuales se sigue buscando el pago de una orden pendiente.
BINANCE_VERIFY_WINDOW_MINUTES=180
# Margen aceptado por debajo del monto esperado (USDT). El sobrepago siempre
# se acepta.
BINANCE_AMOUNT_TOLERANCE=0.02
# Binance no siempre propaga la nota del emisor: muchas transferencias reales
# llegan con memo vacío. Con esto en 'true', un pago sin memo se acredita si
# el monto y la ventana de tiempo coinciden y no hay ninguna ambigüedad.
BINANCE_MATCH_BY_AMOUNT=true

# ─── Extraccion IA de referencias en comprobantes ───────────────────────────
GEMINI_API_KEY=AIzaSyAsD1ySQ4V6BXqoYus9Uas9OPuVNAJoceo
GEMINI_REFERENCE_TIMEOUT=25

# ─── Verificación de ID (scraping) ──────────────────────────────────────────
SCRAPE_ENABLED=true

# ─── Mini juegos (solo desarrollo/pruebas locales) ─────────────────────────
# Activa esto solo en desarrollo para mostrar el bloque en todas las órdenes
# y forzar un premio desde el primer intento para probar la UI.
MINIGAME_DEV_MODE=false

# ─── Correo (SMTP) ──────────────────────────────────────────────────────────
# Solo estas 2 variables son necesarias para activar las notificaciones por correo.
# Para Gmail: crea una "contraseña de aplicación" → https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
